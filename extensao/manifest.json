{
  "manifest_version": 3,
  "name": "Assistente de Horas PSOffice",
  "version": "1.1.0",
  "description": "Lembra, sugere e preenche o apontamento de horas do PSOffice a partir da sua atividade no GitHub.",
  "key": "",
  "icons": {
    "48": "icone48.png",
    "128": "icone128.png"
  },
  "action": {
    "default_title": "Abrir minhas horas no PSOffice",
    "default_icon": {
      "48": "icone48.png"
    }
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://psofficeapp.com.br/*",
    "https://brasilapi.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://psofficeapp.com.br/*/psoffice/horas/horasnew.do*"
      ],
      "js": [
        "lib/regras.js",
        "lib/psoffice.js",
        "lib/config.js",
        "lib/assistente.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
